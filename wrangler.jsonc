{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Pacific Hotel public website: static files only, built by `next build` into ./out.
  "name": "pacific-hotel",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./out", "not_found_handling": "404-page" },
  "workers_dev": true,
  "preview_urls": false
}
